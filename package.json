{
  "name": "@johnmorrisdotca/jisho",
  "version": "2.6.0",
  "description": "Jisho 辞書 — Japanese word and kanji data for JavaScript: look words up by reading, written form, English meaning, a kanji in them or romaji, fetched about 25 kB at a time, safe by default or unfiltered with every sense's JMdict marks, and bring your own block and allow lists; and the grades, JLPT levels, readings and look-alikes of 2,999 kanji. Typed, no dependencies.",
  "keywords": [
    "child-safe",
    "cjk",
    "confusable-kanji",
    "dataset",
    "dictionary",
    "edrdg",
    "japanese",
    "japanese-dictionary",
    "japanese-language",
    "japanese-words",
    "jinmeiyo-kanji",
    "jisho",
    "jlpt",
    "jlpt-kanji",
    "jlpt-n1",
    "jlpt-n5",
    "jmdict",
    "joyo-kanji",
    "kana",
    "kanji",
    "kanji-data",
    "kanjidic",
    "kanjidic2",
    "kunyomi",
    "kyoiku-kanji",
    "language-learning",
    "lazy-loading",
    "look-alike-kanji",
    "onyomi",
    "reading",
    "readings",
    "romaji",
    "school-grades",
    "similar-kanji",
    "stroke-count",
    "typescript",
    "vocabulary",
    "word-lookup",
    "zero-dependency"
  ],
  "homepage": "https://johnmorrisdotca.github.io/jisho/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/jisho.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/jisho/issues"
  },
  "author": "John Morris",
  "license": "(MIT AND CC-BY-SA-4.0 AND CC-BY-4.0 AND CC-BY-3.0 AND CC-BY-2.0)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deinflect": {
      "types": "./dist/deinflect.d.ts",
      "import": "./dist/deinflect.js",
      "default": "./dist/deinflect.js"
    },
    "./entries": {
      "types": "./dist/entries.d.ts",
      "import": "./dist/entries.js",
      "default": "./dist/entries.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js",
      "default": "./dist/examples.js"
    },
    "./grades": {
      "types": "./dist/data/grades.data.d.ts",
      "import": "./dist/data/grades.data.js",
      "default": "./dist/data/grades.data.js"
    },
    "./jlpt": {
      "types": "./dist/data/jlpt.data.d.ts",
      "import": "./dist/data/jlpt.data.js",
      "default": "./dist/data/jlpt.data.js"
    },
    "./kanji": {
      "types": "./dist/data/kanji.data.d.ts",
      "import": "./dist/data/kanji.data.js",
      "default": "./dist/data/kanji.data.js"
    },
    "./look-alike": {
      "types": "./dist/data/look-alike.data.d.ts",
      "import": "./dist/data/look-alike.data.js",
      "default": "./dist/data/look-alike.data.js"
    },
    "./words": {
      "types": "./dist/words.d.ts",
      "import": "./dist/words.js",
      "default": "./dist/words.js"
    },
    "./words-common": {
      "types": "./dist/data/words/common.data.d.ts",
      "import": "./dist/data/words/common.data.js",
      "default": "./dist/data/words/common.data.js"
    },
    "./words-common-extra": {
      "types": "./dist/data/words/common-extra.data.d.ts",
      "import": "./dist/data/words/common-extra.data.js",
      "default": "./dist/data/words/common-extra.data.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:size",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "test:usage": "pnpm build && pnpm site && node scripts/check-usage.mjs",
    "check:standard": "node scripts/check-standard.mjs",
    "data": "node scripts/build-data.mjs",
    "words": "node scripts/build-words.mjs",
    "examples": "node scripts/build-examples.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "format": "biome check --write .",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@biomejs/biome": "2.6.4",
    "@johnmorrisdotca/kazoku-ui": "^0.14.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.0",
    "marked": "^18.0.0",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.0",
    "vue": "^3.5.44",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "packageManager": "pnpm@10.11.0"
}
