{
  "name": "@johnmorrisdotca/moji",
  "version": "0.1.1",
  "description": "Moji 文字 — Japanese word and kanji data for JavaScript: the words of JMdict looked up by reading or written form, in small pieces fetched as needed, with the senses not for children left out; and the school grades, JLPT levels, readings, meanings and look-alike pairs of 2,999 kanji. Typed. Zero dependencies.",
  "keywords": [
    "child-safe",
    "cjk",
    "confusable-kanji",
    "dataset",
    "dictionary",
    "edrdg",
    "japanese",
    "japanese-dictionary",
    "japanese-language",
    "japanese-words",
    "jinmeiyo-kanji",
    "jlpt",
    "jlpt-kanji",
    "jlpt-n1",
    "jlpt-n5",
    "jmdict",
    "joyo-kanji",
    "kana",
    "kanji",
    "kanji-data",
    "kanjidic",
    "kanjidic2",
    "kunyomi",
    "kyoiku-kanji",
    "language-learning",
    "lazy-loading",
    "look-alike-kanji",
    "moji",
    "onyomi",
    "reading",
    "readings",
    "school-grades",
    "similar-kanji",
    "stroke-count",
    "typescript",
    "vocabulary",
    "word-lookup",
    "zero-dependency"
  ],
  "homepage": "https://johnmorrisdotca.github.io/moji/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/moji.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/moji/issues"
  },
  "author": "John Morris",
  "license": "(MIT AND CC-BY-SA-4.0 AND CC-BY-4.0 AND CC-BY-3.0)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./grades": {
      "types": "./dist/data/grades.data.d.ts",
      "import": "./dist/data/grades.data.js",
      "default": "./dist/data/grades.data.js"
    },
    "./jlpt": {
      "types": "./dist/data/jlpt.data.d.ts",
      "import": "./dist/data/jlpt.data.js",
      "default": "./dist/data/jlpt.data.js"
    },
    "./kanji": {
      "types": "./dist/data/kanji.data.d.ts",
      "import": "./dist/data/kanji.data.js",
      "default": "./dist/data/kanji.data.js"
    },
    "./look-alike": {
      "types": "./dist/data/look-alike.data.d.ts",
      "import": "./dist/data/look-alike.data.js",
      "default": "./dist/data/look-alike.data.js"
    },
    "./words": {
      "types": "./dist/words.d.ts",
      "import": "./dist/words.js",
      "default": "./dist/words.js"
    },
    "./words-common": {
      "types": "./dist/data/words/common.data.d.ts",
      "import": "./dist/data/words/common.data.js",
      "default": "./dist/data/words/common.data.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:size",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "data": "node scripts/build-data.mjs",
    "words": "node scripts/build-words.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "format": "biome check --write .",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.0",
    "marked": "^18.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
